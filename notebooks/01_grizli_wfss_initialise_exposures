    "import sep\n",
    "from scipy import ndimage as nd\n",
    "\n",
    "BAD_DQ = 1 | 2 | 1024 | 2048 | 8192 | 16384   # DO_NOT_USE, SATURATED, DEAD, HOT, LOW_QE, RC\n",
    "\n",
    "\n",
    "def get_key(files, key, default=None):\n",
    "    \"\"\"Find a header keyword in the primary or SCI header.\"\"\"\n",
    "    for f in files:\n",
    "        with fits.open(f) as hdul:\n",
    "            for ext in (0, 'SCI'):\n",
    "                if key in hdul[ext].header:\n",
    "                    return hdul[ext].header[key]\n",
    "    return default\n",
    "\n",
    "\n",
    "def build_mosaic(root, direct_files):\n",
    "    sci_file, wht_file = f'{root}_drz_sci.fits', f'{root}_drz_wht.fits'\n",
    "    if os.path.exists(sci_file) and os.path.exists(wht_file):\n",
    "        return sci_file, wht_file\n",
    "\n",
    "    sci_list, wht_list, wcs_list = [], [], []\n",
    "    for f in direct_files:\n",
    "        with fits.open(f) as hdul:\n",
    "            sci = np.ascontiguousarray(hdul['SCI'].data, dtype=np.float32)\n",
    "            err = np.ascontiguousarray(hdul['ERR'].data, dtype=np.float32)\n",
    "            dq = hdul['DQ'].data\n",
    "            w = pywcs.WCS(hdul['SCI'].header, fobj=hdul, relax=True)\n",
    "        w.pixel_shape = sci.shape[::-1]\n",
    "        w.pscale = utils.get_wcs_pscale(w)\n",
    "\n",
    "        bad = ((dq & BAD_DQ) > 0) | ~np.isfinite(sci) | ~np.isfinite(err) | (err <= 0)\n",
    "        sci[bad] = 0\n",
    "        bkg = sep.Background(sci, mask=bad, bw=64, bh=64, fw=3, fh=3)\n",
    "        sci = (sci - bkg.back()).astype(np.float32)\n",
    "        wht = np.where(bad, 0, 1.0 / np.maximum(err, 1e-12) ** 2).astype(np.float32)\n",
    "        sci[bad] = 0\n",
    "        sci_list.append(sci); wht_list.append(wht); wcs_list.append(w)\n",
    "\n",
    "    fp = np.vstack([w.calc_footprint() for w in wcs_list])\n",
    "    ra = ((fp[:, 0] - fp[0, 0] + 180) % 360) - 180 + fp[0, 0]\n",
    "    dec = fp[:, 1]\n",
    "    ra0, dec0 = 0.5 * (ra.min() + ra.max()), 0.5 * (dec.min() + dec.max())\n",
    "\n",
    "    tmp = pywcs.WCS(naxis=2)\n",
    "    tmp.wcs.ctype = ['RA---TAN', 'DEC--TAN']\n",
    "    tmp.wcs.crval = [ra0, dec0]\n",
    "    tmp.wcs.cdelt = [-PIXSCALE / 3600., PIXSCALE / 3600.]\n",
    "    tmp.wcs.crpix = [1., 1.]\n",
    "    x, y = tmp.wcs_world2pix(ra, dec, 1)\n",
    "    pad = 20\n",
    "    nx = int(np.ceil(x.max() - x.min())) + 2 * pad\n",
    "    ny = int(np.ceil(y.max() - y.min())) + 2 * pad\n",
    "\n",
    "    wcs_hdr = fits.Header()\n",
    "    wcs_hdr['NAXIS'] = 2\n",
    "    wcs_hdr['NAXIS1'], wcs_hdr['NAXIS2'] = nx, ny\n",
    "    wcs_hdr['CTYPE1'], wcs_hdr['CTYPE2'] = 'RA---TAN', 'DEC--TAN'\n",
    "    wcs_hdr['CUNIT1'], wcs_hdr['CUNIT2'] = 'deg', 'deg'\n",
    "    wcs_hdr['CRPIX1'] = 1. - x.min() + pad\n",
    "    wcs_hdr['CRPIX2'] = 1. - y.min() + pad\n",
    "    wcs_hdr['CRVAL1'], wcs_hdr['CRVAL2'] = ra0, dec0\n",
    "    wcs_hdr['CD1_1'], wcs_hdr['CD1_2'] = -PIXSCALE / 3600., 0.\n",
    "    wcs_hdr['CD2_1'], wcs_hdr['CD2_2'] = 0., PIXSCALE / 3600.\n",
    "    wcs_hdr['RADESYS'] = 'ICRS'\n",
    "\n",
    "    out_wcs = pywcs.WCS(wcs_hdr)\n",
    "    out_wcs.pixel_shape = (nx, ny)\n",
    "    out_wcs.pscale = utils.get_wcs_pscale(out_wcs)\n",
    "\n",
    "    res = utils.drizzle_array_groups(sci_list, wht_list, wcs_list, outputwcs=out_wcs, scale=PIXSCALE,\n",
    "                                     kernel='square', pixfrac=0.8, verbose=False)\n",
    "    outsci, outwht = res[0], res[1]\n",
    "\n",
    "    hdr = wcs_hdr.copy()\n",
    "    for k in ['TELESCOP', 'INSTRUME', 'DETECTOR', 'FILTER', 'PUPIL', 'MODULE',\n",
    "              'OTELESCOP', 'OINSTRUME', 'ODETECTO', 'OFILTER', 'OPUPIL', 'OEXP_TYP',\n",
    "              'PHOTFLAM', 'PHOTPLAM', 'PHOTMJSR', 'PHOTUJA2']:\n",
    "        v = get_key(direct_files, k)\n",
    "        if v is not None:\n",
    "            hdr[k] = v\n",
    "    hdr['EXPTIME'] = float(sum(get_key([f], 'EFFEXPTM', 0.) for f in direct_files))\n",
    "    hdr['BUNIT'] = 'DN/s'\n",
    "    for k in ('PHOTFLAM', 'PHOTPLAM'):\n",
    "        if k not in hdr:\n",
    "            raise RuntimeError(f'{k} missing from the mosaic header (direct images not initialised?)')\n",
    "\n",
    "    fits.writeto(sci_file, outsci.astype(np.float32), header=hdr, overwrite=True)\n",
    "    fits.writeto(wht_file, outwht.astype(np.float32), header=hdr, overwrite=True)\n",
    "    print(f'  mosaic {root}: {nx} x {ny} px from {len(direct_files)} direct exposure(s)')\n",
    "    return sci_file, wht_file\n",
    "\n",
    "\n",
    "def build_catalog(root, sci_file, wht_file):\n",
    "    cat_file, seg_file = f'{root}.cat.fits', f'{root}_seg.fits'\n",
    "    if not (os.path.exists(cat_file) and os.path.exists(seg_file)):\n",
    "        prep.make_SEP_catalog(root=root, sci=sci_file, wht=wht_file, threshold=2.0, get_background=True)\n",
    "    for f in (cat_file, seg_file):\n",
    "        if not os.path.exists(f):\n",
    "            raise RuntimeError(f'{f} not written by make_SEP_catalog: {glob.glob(root + \"*\")}')\n",
    "    return cat_file, seg_file"
   ]
