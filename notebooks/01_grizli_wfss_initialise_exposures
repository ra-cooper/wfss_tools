    "KEY_LEN = {'visit': 13, 'observation': 10, 'program': 7}[GROUP_BY]\n",
    "DIRECT_FILTER_MAP = {}\n",
    "\n",
    "def label_of(fn):\n",
    "    return fn[:KEY_LEN]\n",
    "\n",
    "\n",
    "def cluster_by_sky(ra, dec, sep_arcsec):\n",
    "    \"\"\"Single-linkage clusters of pointings closer than sep_arcsec.\"\"\"\n",
    "    import astropy.units as u\n",
    "    from astropy.coordinates import SkyCoord\n",
    "    from scipy.sparse import coo_matrix\n",
    "    from scipy.sparse.csgraph import connected_components\n",
    "    n = len(ra)\n",
    "    if n == 1:\n",
    "        return np.zeros(1, dtype=int)\n",
    "    c = SkyCoord(np.asarray(ra) * u.deg, np.asarray(dec) * u.deg)\n",
    "    i1, i2, _, _ = c.search_around_sky(c, sep_arcsec * u.arcsec)\n",
    "    graph = coo_matrix((np.ones(len(i1)), (i1, i2)), shape=(n, n))\n",
    "    return connected_components(graph, directed=False)[1]\n",
    "\n",
    "\n",
    "    return np.hypot((np.asarray(ra) - ra0) * np.cos(np.deg2rad(dec0)), np.asarray(dec) - dec0) * 3600.\n",
    "\n",
    "\n",
    "def filter_number(f):\n",
    "    m = re.findall(r'\\d+', str(f))\n",
    "    return int(m[0]) if m else 0\n",
    "\n",
    "\n",
    "def select_direct(direct, label, module, wanted, ra0, dec0):\n",
    "    \"\"\"Return (files, filter_used) for the direct images matching a grism group.\"\"\"\n",
    "    pool = direct[direct['module'] == module]\n",
    "    if len(pool) == 0:\n",
    "        return [], None\n",
    "    to_try = [DIRECT_FILTER_MAP.get(wanted, wanted)]\n",
    "    others = sorted(set(pool['filter']) - set(to_try), key=lambda f: abs(filter_number(f) - filter_number(wanted)))\n",
    "    to_try += others\n",
    "    near = sep_arcsec(pool['ra'], pool['dec'], ra0, dec0) < 150\n",
    "    same = np.array([label_of(fn) == label for fn in pool['file']])\n",
    "    for f in to_try:\n",
    "        m = (pool['filter'] == f)\n",
    "        for extra in ([same & near]):\n",
    "            sel = m & extra\n",
    "            if sel.any():\n",
    "                return list(pool['file'][sel]), f\n",
    "    return [], None\n",
    "\n",
    "\n",
    "def build_groups(info):\n",
    "    grism = info[info['kind'] == 'grism']\n",
    "    direct = info[info['kind'] == 'direct']\n",
    "\n",
    "    keys = OrderedDict()\n",
    "    for i in range(len(grism)):\n",
    "        r = grism[i]\n",
    "        pup = '' if COMBINE_GRISMS else r['pupil']\n",
    "        keys.setdefault((label_of(r['file']), r['module'], r['filter'], pup), []).append(i)\n",
    "\n",
    "    groups = []\n",
    "    for (label, module, filt, pup), idx in keys.items():\n",
    "        sub = grism[idx]\n",
    "        cl = cluster_by_sky(sub['ra'], sub['dec'], 150)\n",
    "        ncl = int(cl.max()) + 1\n",
    "        for c in range(ncl):\n",
    "            s = sub[cl == c]\n",
    "            ra0, dec0 = float(np.mean(s['ra'])), float(np.mean(s['dec']))\n",
    "            dfiles, dfilt = select_direct(direct, label, module, filt, ra0, dec0)\n",
    "            g_files = list(s['file'])\n",
    "            pupils = sorted(set(s['pupil']))\n",
    "            root_tag = f'{label}-mod{module}-{(dfilt or filt).lower()}'\n",
    "            if ncl > 1:\n",
    "                root_tag += '-' + hashlib.md5('|'.join(sorted(dfiles) or sorted(g_files)).encode()).hexdigest()[:6]\n",
    "            root = f'{FIELD_ROOT}-{root_tag}'\n",
    "            gid = f'{root}-' + '+'.join(p.lower() for p in pupils)\n",
    "\n",
    "            g = dict(id=gid, root=root, label=label, module=module, filter=filt, pupils=pupils,\n",
    "                     grism_files=g_files, direct_files=dfiles, direct_filter=dfilt, ra=ra0, dec=dec0,\n",
    "                     skip_reason=None)\n",
    "            if len(dfiles) == 0:\n",
    "                g['skip_reason'] = f'no {module}-module direct image in {DIRECT_FILTER_MAP.get(filt, filt)} found'\n",
    "            groups.append(g)\n",
    "    return groups\n",
    "\n",
    "\n",
    "groups = build_groups(info)\n",
    "\n",
    "Table(rows=[(g['id'], len(g['grism_files']), len(g['direct_files']), g['direct_filter'], g['skip_reason'] or '')\n",
    "            for g in groups],\n",
    "      names=['group', 'N_grism', 'N_direct', 'direct_filter', 'skip_reason']).pprint_all(max_width=200)"
   ]
