    "import json, datetime\n",
    "from astropy.coordinates import SkyCoord\n",
    "import astropy.units as u\n",
    "\n",
    "\n",
    "def mosaic_info(sci_file, wht_file):\n",
    "    \"\"\"Pixel scale, sky centre and sky extent of the part of the mosaic that has weight.\"\"\"\n",
    "    w = pywcs.WCS(fits.getheader(sci_file))\n",
    "    wht = fits.getdata(wht_file)\n",
    "    ys, xs = np.where(wht > 0)\n",
    "    if len(xs) == 0:\n",
    "        raise RuntimeError('mosaic has no pixels with weight')\n",
    "    x0, x1, y0, y1 = int(xs.min()), int(xs.max()), int(ys.min()), int(ys.max())\n",
    "    cx, cy = 0.5 * (x0 + x1), 0.5 * (y0 + y1)\n",
    "    corners = [(x0, y0), (x1, y0), (x1, y1), (x0, y1)]\n",
    "    cra, cdec = w.all_pix2world([cx], [cy], 0)\n",
    "    fra, fdec = w.all_pix2world([c[0] for c in corners], [c[1] for c in corners], 0)\n",
    "    cen = SkyCoord(float(cra[0]) * u.deg, float(cdec[0]) * u.deg)\n",
    "    radius = float(cen.separation(SkyCoord(fra * u.deg, fdec * u.deg)).arcsec.max())\n",
    "    from astropy.wcs.utils import proj_plane_pixel_scales\n",
    "    return dict(center_ra=float(cra[0]), center_dec=float(cdec[0]), radius_arcsec=radius,\n",
    "                footprint=[[float(a), float(b)] for a, b in zip(fra, fdec)],\n",
    "                pixscale=float(np.mean(proj_plane_pixel_scales(w)) * 3600.),\n",
    "                shape=[int(wht.shape[1]), int(wht.shape[0])], covered_fraction=float((wht > 0).mean()))\n",
    "\n",
    "\n",
    "def catalog_info(cat_file):\n",
    "    cat = Table.read(cat_file)\n",
    "    mag = np.asarray(cat['MAG_AUTO'], dtype=float) if 'MAG_AUTO' in cat.colnames else np.array([])\n",
    "    mag = mag[np.isfinite(mag)]\n",
    "    pct = [float(x) for x in np.percentile(mag, [1, 50, 99])] if len(mag) else []\n",
    "    return dict(n_sources=int(len(cat)), mag_auto_1_50_99=pct)\n",
    "\n",
    "\n",
    "records = []\n",
    "t_all = time.time()\n",
    "for gi, g in enumerate(groups, 1):\n",
    "    print(f'[{gi}/{len(groups)}] {g[\"id\"]}')\n",
    "    rec = dict(g)\n",
    "    rec.update(status='', note='', mosaic_sci='', mosaic_wht='', catalog='', segmentation='')\n",
    "    if g['skip_reason']:\n",
    "        rec.update(status='skipped', note=g['skip_reason'])\n",
    "        print('   skipped:', g['skip_reason'])\n",
    "        records.append(rec)\n",
    "        continue\n",
    "    try:\n",
    "        os.chdir(PREP_DIR)\n",
    "        sci_file, wht_file = build_mosaic(g['root'], g['direct_files'])\n",
    "        cat_file, seg_file = build_catalog(g['root'], sci_file, wht_file)\n",
    "        rec.update(mosaic_info(sci_file, wht_file))\n",
    "        rec.update(catalog_info(cat_file))\n",
    "        rec.update(status='ok', mosaic_sci=sci_file, mosaic_wht=wht_file, catalog=cat_file, segmentation=seg_file)\n",
    "        print(f'   ok: {rec[\"n_sources\"]} sources | mosaic {rec[\"shape\"][0]}x{rec[\"shape\"][1]} | radius {rec[\"radius_arcsec\"]:.0f}\"')\n",
    "    except Exception as e:\n",
    "        traceback.print_exc()\n",
    "        rec.update(status='failed', note=repr(e)[:200])\n",
    "    finally:\n",
    "        os.chdir(PREP_DIR)\n",
    "        gc.collect()\n",
    "    records.append(rec)\n",
    "\n",
    "# ---- merge with an existing manifest (same group id -> replaced) ----\n",
    "by_id = OrderedDict()\n",
    "if MANIFEST.exists():\n",
    "    old = json.loads(MANIFEST.read_text())\n",
    "    for r in old.get('groups', []):\n",
    "        by_id[r['id']] = r\n",
    "    print(f'\\nmerging into existing manifest ({len(by_id)} groups)')\n",
    "for r in records:\n",
    "    by_id[r['id']] = r\n",
    "\n",
    "manifest = dict(\n",
    "    created=datetime.datetime.now().isoformat(timespec='seconds'),\n",
    "    grizli_version=grizli.__version__,\n",
    "    prep_dir=str(PREP_DIR),\n",
    "    settings=dict(FIELD_ROOT=FIELD_ROOT, PIXSCALE=PIXSCALE, GROUP_BY=GROUP_BY, COMBINE_GRISMS=COMBINE_GRISMS,\n",
    "                  NIRCAM_CONF_VERSION=NIRCAM_CONF_VERSION, USE_JWST_CRDS=USE_JWST_CRDS),\n",
    "    groups=list(by_id.values()),\n",
    ")\n",
    "\n",
    "\n",
    "def _js(o):\n",
    "    if isinstance(o, np.integer):\n",
    "        return int(o)\n",
    "    if isinstance(o, np.floating):\n",
    "        return float(o)\n",
    "    if isinstance(o, np.ndarray):\n",
    "        return o.tolist()\n",
    "    return str(o)\n",
    "\n",
    "\n",
    "MANIFEST.write_text(json.dumps(manifest, indent=1, default=_js))\n",
    "cols = ['id', 'status', 'module', 'filter', 'pupils', 'n_sources', 'center_ra', 'center_dec', 'radius_arcsec', 'note']\n",
    "Table(rows=[[(', '.join(r[c]) if c == 'pupils' else r.get(c, '')) for c in cols] for r in manifest['groups']],\n",
    "      names=cols).write(WORKDIR / 'groups.csv', format='ascii.csv', overwrite=True)\n",
    "\n",
    "print(f'\\nManifest: {MANIFEST} ({len(manifest[\"groups\"])} groups, {sum(r[\"status\"] == \"ok\" for r in manifest[\"groups\"])} ok) '\n",
    "      f'| {(time.time() - t_all) / 60:.1f} min this run')\n",
    "Table(rows=[[(', '.join(r[c]) if c == 'pupils' else r.get(c, '')) for c in cols[:-1]] for r in manifest['groups']],\n",
    "      names=cols[:-1]).pprint_all(max_width=200)\n",
    "for r in manifest['groups']:\n",
    "    if r['status'] in ('failed', 'skipped'):\n",
    "        print(f'  {r[\"status\"].upper():8s} {r[\"id\"]}: {r[\"note\"]}')"
   ]
