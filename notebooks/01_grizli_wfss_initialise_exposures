    "# Make files grizli compatible\n",
    "def okey(h, k):\n",
    "    \"\"\"Original value of a keyword (grizli keeps 'O'+first 7 chars when it rewrites a header).\"\"\"\n",
    "    return h.get('O' + k[:7], h.get(k))\n",
    "\n",
    "# Get WCS\n",
    "def pointing(f):\n",
    "    with fits.open(f) as hdul:\n",
    "        for ext in ('SCI', 0):\n",
    "            h = hdul[ext].header\n",
    "            for kr, kd in (('RA_V1', 'DEC_V1'), ('RA_REF', 'DEC_REF'), ('CRVAL1', 'CRVAL2'), ('TARG_RA', 'TARG_DEC')):\n",
    "                return float(h[kr]), float(h[kd])\n",
    "    return np.nan, np.nan\n",
    "\n",
    "\n",
    "# Select all objects and split between GRISM images and direct images\n",
    "rows = []\n",
    "for f in sorted(glob.glob(str(PREP_DIR / 'jw*_rate.fits'))):\n",
    "    fn = os.path.basename(f)\n",
    "    if not any(d in fn for d in dets):\n",
    "        continue\n",
    "    if VISITS and fn[:13] not in VISITS:\n",
    "        continue\n",
    "    h = fits.getheader(f, 0)\n",
    "    exp_type, pupil, filt = okey(h, 'EXP_TYPE'), str(okey(h, 'PUPIL')), str(okey(h, 'FILTER'))\n",
    "    if pupil.startswith('GRISM') and exp_type == 'NRC_WFSS':\n",
    "        kind = 'grism'\n",
    "    elif exp_type == 'NRC_IMAGE':\n",
    "        kind = 'direct'\n",
    "    else:\n",
    "        kind = 'other'\n",
    "    ra, dec = pointing(f)\n",
    "    rows.append(dict(file=fn, kind=kind, filter=filt, pupil=pupil, module=str(h.get('MODULE')),\n",
    "                     detector=str(okey(h, 'DETECTOR')), exp_type=str(exp_type),\n",
    "                     exptime=float(h.get('EFFEXPTM', np.nan)), ra=ra, dec=dec))\n",
    "\n",
    "info = Table(rows)\n",
    "\n",
    "is_grism = (info['kind'] == 'grism') & np.isin(info['pupil'], GRISMS)\n",
    "if FILTERS:\n",
    "    is_grism &= np.isin(info['filter'], FILTERS)\n",
    "info = info[is_grism | (info['kind'] == 'direct')]\n",
    "\n",
    "print(len(info), 'exposures:', {k: int((info['kind'] == k).sum()) for k in ('grism', 'direct')})\n",
    "t = info.group_by(['kind', 'module', 'filter', 'pupil'])\n",
    "Table(rows=[(k['kind'], k['module'], k['filter'], k['pupil'], len(g)) for k, g in zip(t.groups.keys, t.groups)],\n",
    "      names=['kind', 'module', 'filter', 'pupil', 'N']).pprint_all()"
